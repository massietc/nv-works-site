/* ==========================================================
   NV Works — Ambientenbeleuchtung & Sternenhimmel
   Design tokens
   Color:  --ink #0B0B0D (background), --ink-2 #131316 (panels),
           --red #C81E2C (primary accent), --red-deep #7A0F1A (gradient),
           --white #F4F4F5 (text), --grey #9A9AA2 (muted text)
   Type:   Oswald (display, condensed industrial — echoes the logo's
           angular NV/WORKS lettering), Inter (body, clean and legible)
   Signature: canvas starfield behind the hero, referencing the
           "Sternenhimmel" (star headliner) product directly
   ========================================================== */

:root {
  --ink: #0b0b0d;
  --ink-2: #131316;
  --ink-3: #1b1b1f;
  --red: #c81e2c;
  --red-deep: #7a0f1a;
  --white: #f4f4f5;
  --grey: #9a9aa2;
  --line: #262629;
  --radius: 4px;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--ink);
  color: var(--white);
  font-family: 'Inter', -apple-system, sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

h1, h2 {
  font-family: 'Oswald', 'Inter', sans-serif;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  margin: 0;
}

a { color: inherit; text-decoration: none; }

img { max-width: 100%; display: block; }

/* ---------- Nav ---------- */

.nav {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(11, 11, 13, 0.9);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--line);
}

.nav-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 14px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-logo {
  height: 42px;
  width: auto;
}

.nav-cta {
  border: 1px solid var(--red);
  color: var(--white);
  background: var(--red);
  padding: 10px 20px;
  border-radius: var(--radius);
  font-family: 'Oswald', sans-serif;
  font-size: 0.85rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  transition: background 0.2s ease, color 0.2s ease;
}

.nav-cta:hover { background: transparent; color: var(--red); }

.nav-cta.ghost {
  background: transparent;
  color: var(--white);
  border-color: var(--line);
}
.nav-cta.ghost:hover { border-color: var(--red); color: var(--red); }

/* ---------- Hero ---------- */

.hero {
  position: relative;
  min-height: 88vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  border-bottom: 1px solid var(--line);
}

#starfield {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(ellipse at 30% 20%, #17070a 0%, var(--ink) 60%);
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
  width: 100%;
}

.eyebrow {
  font-family: 'Oswald', sans-serif;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 0.78rem;
  color: var(--red);
  margin: 0 0 18px;
}

.eyebrow.center { text-align: center; }

.hero h1 {
  font-size: clamp(2.4rem, 6vw, 4.4rem);
  line-height: 1.05;
  margin-bottom: 22px;
}

.hero-sub {
  max-width: 560px;
  color: var(--grey);
  font-size: 1.05rem;
  margin-bottom: 34px;
}

.btn-primary {
  display: inline-block;
  background: linear-gradient(180deg, var(--red) 0%, var(--red-deep) 100%);
  color: var(--white);
  padding: 16px 32px;
  border: none;
  border-radius: var(--radius);
  font-family: 'Oswald', sans-serif;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.92rem;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 24px rgba(200, 30, 44, 0.35);
}

/* ---------- Intro ---------- */

.intro { padding: 90px 24px; border-bottom: 1px solid var(--line); }

.intro-grid {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
}

.intro-card h2 {
  font-size: 1.5rem;
  color: var(--white);
  margin-bottom: 16px;
  border-left: 3px solid var(--red);
  padding-left: 14px;
}

.intro-card p { color: var(--grey); margin: 0 0 14px; }

/* ---------- Services ---------- */

.services { padding: 80px 24px; border-bottom: 1px solid var(--line); }

.service-list {
  max-width: 720px;
  margin: 30px auto 0;
  padding: 0;
  list-style: none;
}

.service-list li {
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
  color: var(--white);
  font-size: 1.05rem;
  position: relative;
  padding-left: 28px;
}

.service-list li::before {
  content: "—";
  color: var(--red);
  position: absolute;
  left: 0;
}

/* ---------- Brands ---------- */

.brands { padding: 80px 24px; border-bottom: 1px solid var(--line); }

.brand-grid {
  max-width: 900px;
  margin: 30px auto 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
}

.brand-grid span {
  background: var(--ink);
  padding: 18px 10px;
  text-align: center;
  font-size: 0.85rem;
  color: var(--grey);
  letter-spacing: 0.02em;
}

/* ---------- CTA ---------- */

.cta {
  padding: 100px 24px;
  text-align: center;
  background: linear-gradient(180deg, var(--ink) 0%, #150708 100%);
}

.cta h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin-bottom: 16px; }
.cta p { color: var(--grey); margin: 0 0 32px; }

/* ---------- Footer ---------- */

.footer {
  padding: 40px 24px;
  text-align: center;
  border-top: 1px solid var(--line);
}

.footer-logo { height: 36px; margin: 0 auto 14px; opacity: 0.85; }
.footer p { color: var(--grey); font-size: 0.85rem; margin: 0; }

/* ---------- Form page ---------- */

.form-hero {
  max-width: 700px;
  margin: 0 auto;
  padding: 70px 24px 20px;
  text-align: center;
}

.form-hero h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: 10px 0 16px; }
.form-hero .hero-sub { margin: 0 auto; text-align: center; }

.form-wrap {
  max-width: 700px;
  margin: 0 auto;
  padding: 20px 24px 100px;
}

form { display: flex; flex-direction: column; gap: 36px; }

.form-section {
  background: var(--ink-2);
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 28px;
}

.form-section h2 {
  font-size: 1.05rem;
  color: var(--red);
  margin-bottom: 20px;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.field { margin-bottom: 16px; }
.field:last-child { margin-bottom: 0; }

label {
  display: block;
  font-size: 0.82rem;
  color: var(--grey);
  margin-bottom: 8px;
  letter-spacing: 0.02em;
}

input, select, textarea {
  width: 100%;
  background: var(--ink-3);
  border: 1px solid var(--line);
  color: var(--white);
  padding: 12px 14px;
  border-radius: var(--radius);
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
}

input:focus, select:focus, textarea:focus {
  outline: 2px solid var(--red);
  outline-offset: 1px;
  border-color: var(--red);
}

textarea { resize: vertical; }

.conditional-group {
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px dashed var(--line);
}

.conditional-group.hidden { display: none; }

.checkbox-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.checkbox {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--white);
  font-size: 0.9rem;
}

.checkbox input { width: auto; }

.btn-submit {
  width: 100%;
  padding: 18px;
  font-size: 1rem;
}

.form-status {
  text-align: center;
  min-height: 20px;
  font-size: 0.9rem;
  color: var(--grey);
}

.form-status.success { color: #4caf50; }
.form-status.error { color: var(--red); }

/* ---------- Responsive ---------- */

@media (max-width: 720px) {
  .intro-grid { grid-template-columns: 1fr; gap: 40px; }
  .brand-grid { grid-template-columns: repeat(2, 1fr); }
  .field-row { grid-template-columns: 1fr; gap: 0; }
  .checkbox-grid { grid-template-columns: 1fr; }
}

/* ---------- Reduced motion ---------- */

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .btn-primary:hover { transform: none; }
}
